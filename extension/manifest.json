{
  "manifest_version": 3,
  "name": "ClaudeSkin Companion",
  "description": "Apply themes selected in the local ClaudeSkin manager to claude.ai.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["alarms"],
  "host_permissions": ["https://claude.ai/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["skin-engine.js", "content.js"], "run_at": "document_idle"}]
}
